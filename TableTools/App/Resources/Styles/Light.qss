QWidget {
  color: #20242A;
  font-family: "Microsoft YaHei UI", "Noto Sans SC", "Segoe UI";
  font-size: 13px;
}
QMainWindow, QWidget#Root { background: #F4F6F8; }
QWidget#TitleBar, QWidget#MenuBar, QWidget#StatusBar { background: #FFFFFF; }
QWidget#ToolRail { background: #E9EDF2; border-right: 1px solid #CBD2DA; }
QWidget#WorkspaceHeader, QWidget#DetailHeader, QWidget#IssuesPanel, QWidget#ExportBar {
  background: #FFFFFF;
  border: 1px solid #CBD2DA;
}
QLabel { background: transparent; }
QLabel#Muted { color: #687383; }
QLabel#Subtle { color: #8C96A3; }
QLabel#Title { color: #15181C; font-size: 20px; font-weight: 600; }
QLabel#TableTitle { color: #15181C; font-size: 18px; font-weight: 600; }
QPushButton, QToolButton { background: #FFFFFF; border: 1px solid #CBD2DA; border-radius: 5px; padding: 6px 10px; }
QPushButton:hover, QToolButton:hover { background: #EDF2F7; border-color: #AEB8C4; }
QPushButton:pressed, QToolButton:pressed { background: #DCE8F8; }
QPushButton:checked { background: #DCE8F8; border-color: #3278E8; color: #2464C1; }
QPushButton:disabled { color: #9AA4B0; background: #EEF1F4; }
QPushButton#Primary { background: #3278E8; border-color: #3278E8; color: white; font-weight: 600; padding: 7px 18px; }
QPushButton#Primary:hover { background: #4387F0; }
QPushButton#Primary:disabled { background: #EEF1F4; border-color: #CBD2DA; color: #9AA4B0; }
QLineEdit, QComboBox { background: #FFFFFF; border: 1px solid #CBD2DA; border-radius: 5px; padding: 7px 9px; }
QLineEdit:focus, QComboBox:focus { border-color: #3278E8; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked { background: #FFFFFF; border: 1px solid #8B97A5; border-radius: 3px; }
QCheckBox::indicator:checked { background: #3278E8; border: 1px solid #3278E8; border-radius: 3px; }
QListWidget, QTableWidget, QTableView { background: #FFFFFF; alternate-background-color: #F6F8FA; border: 1px solid #CBD2DA; gridline-color: #DDE2E8; }
QListWidget::item { height: 38px; border-bottom: 1px solid #E2E6EB; }
QListWidget::item:selected { background: #DCE8F8; }
QTableWidget::item:selected, QTableView::item:selected { background: #DCE8F8; color: #15181C; }
QTableView::item { padding: 4px 8px; }
QHeaderView::section { background: #EDF1F5; color: #687383; border: 0; border-right: 1px solid #CBD2DA; border-bottom: 1px solid #CBD2DA; padding: 7px 8px; }
QTabBar::tab { background: #E9EDF2; border: 1px solid #CBD2DA; border-bottom: 0; padding: 7px 14px; margin-right: 2px; }
QTabBar::tab:selected { background: #FFFFFF; color: #3278E8; }
QScrollArea { border: 0; background: transparent; }
QWidget#BuildLog { background: #DCE8F8; border-radius: 3px; }
QLabel#IssueError { background: #FBE7EA; color: #A33A48; border: 1px solid #E5AAB3; border-radius: 5px; padding: 7px 10px; }
QLabel#IssueWarning { background: #FFF4D8; color: #8A641F; border: 1px solid #E6C97A; border-radius: 5px; padding: 7px 10px; }
QLabel#IssueEmpty { color: #8C96A3; padding: 7px 10px; }
QWidget#IssueError { background: #FBE7EA; border: 1px solid #E5AAB3; border-radius: 5px; }
QWidget#IssueWarning { background: #FFF4D8; border: 1px solid #E6C97A; border-radius: 5px; }
QWidget#IssueError QLabel { color: #A33A48; }
QWidget#IssueWarning QLabel { color: #8A641F; }
QMenu { background: #FFFFFF; border: 1px solid #CBD2DA; padding: 5px; }
QMenu::item { padding: 7px 24px 7px 12px; border-radius: 4px; }
QMenu::item:selected { background: #DCE8F8; }
QToolButton:checked { background: #DCE8F8; border-color: #3278E8; color: #3278E8; }
QToolButton:disabled { color: #9AA4B0; background: transparent; border-color: transparent; }
QWidget#ApplicationMenuBar { background: #FFFFFF; border-bottom: 1px solid #CBD2DA; }
QToolButton#SidebarToggle, QToolButton#ThemeSegment, QToolButton#ToolNavigationButton {
  background: transparent; border: 1px solid transparent; border-radius: 5px; padding: 5px 8px;
}
QToolButton#SidebarToggle:hover, QToolButton#ThemeSegment:hover, QToolButton#ToolNavigationButton:hover { background: #EDF2F7; }
QToolButton#SidebarToggle:checked, QToolButton#ThemeSegment:checked, QToolButton#ToolNavigationButton:checked {
  background: #DCE8F8; border-color: #3278E8; color: #2464C1;
}
QToolButton#ToolNavigationButton { text-align: left; }
QLabel#MenuSubtle { color: #687383; padding-left: 6px; }
QComboBox#LanguageCombo { min-height: 28px; padding: 3px 8px; }
QPushButton#MenuSettings { padding: 5px 10px; border-radius: 5px; }
QMenuBar { background: #FFFFFF; color: #20242A; border-bottom: 1px solid #CBD2DA; padding-left: 8px; }
QMenuBar::item { padding: 7px 12px; border-radius: 4px; }
QMenuBar::item:selected { background: #EDF2F7; }
QGroupBox { background: #FFFFFF; border: 1px solid #CBD2DA; border-radius: 6px; margin-top: 12px; padding: 14px 10px 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #20242A; }
QTabWidget#SettingsTabs::pane { border: 0; background: transparent; }
QPushButton#SettingsNavButton { text-align: left; background: transparent; border: 1px solid transparent; padding: 9px 12px; }
QPushButton#SettingsNavButton:checked { background: #DCE8F8; border-color: #3278E8; color: #2464C1; }
QPushButton#SettingsNavButton:hover:!checked { background: #EDF2F7; }
QLabel#WindowTitle { color: #15181C; font-weight: 600; }
QToolButton#WindowControl { padding: 4px; border: 0; background: transparent; }
QToolButton#WindowControl:hover { background: #EDF2F7; }
QToolButton#WindowControl:pressed { background: #FBE7EA; }
QLabel#PanelTitle { color: #15181C; font-size: 14px; font-weight: 600; }
QLabel#FileName { color: #20242A; padding-left: 2px; }
QLabel#EmptyState { color: #8C96A3; padding: 24px 12px; }
QLabel#PreviewDetails { color: #687383; background: #F6F8FA; border: 1px solid #CBD2DA; border-radius: 4px; padding: 5px 8px; }
QWidget#LogPanel { background: #FFFFFF; border-top: 1px solid #CBD2DA; }
QListWidget#LogList { background: #FFFFFF; border: 1px solid #CBD2DA; }
QListWidget#LogList::item { height: 28px; padding: 3px 8px; border-bottom: 1px solid #E2E6EB; }
QLabel#StatusIdle { color: #687383; }
QLabel#StatusBusy { color: #3278E8; }
QLabel#StatusSuccess { color: #248C67; }
QLabel#StatusError { color: #A33A48; }
QToolButton[IconButton="true"] { padding: 3px; border: 0; background: transparent; }
QToolButton[IconButton="true"]:hover { background: #EDF2F7; }
QToolButton#StatusLogButton { padding: 2px 6px; border: 0; background: transparent; }
QToolButton#StatusLogButton:hover { background: #EDF2F7; }
