<!-- 用途：以 C# 9 验证 Unity Editor 共享源码，避免使用 Unity 2021.3 不支持的语法和隐式 using。编写日期：2026-10-14；修改日期：2026-10-15；作者：Codex。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>bin\EditorShared\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Editor/Shared/IsExternalInit.cs" />
    <Compile Include="../Runtime/Shared/**/*.cs" />
    <Compile Include="../Editor/Shared/Core/**/*.cs" />
    <Compile Include="../Editor/Shared/Serialization/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Text.Encoding.CodePages">
      <HintPath>../Editor/Plugins/System.Text.Encoding.CodePages.dll</HintPath>
    </Reference>
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
