<!-- 用途：在没有 Unity Editor 的环境中验证 Unity Editor 共享解析、校验和导出源码。编写日期：2026-10-14；作者：Codex。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>bin\EditorShared\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Editor/Shared/IsExternalInit.cs" />
    <Compile Include="../Runtime/Shared/**/*.cs" />
    <Compile Include="../Editor/Shared/Core/**/*.cs" />
    <Compile Include="../Editor/Shared/Serialization/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Text.Encoding.CodePages">
      <HintPath>../Editor/Plugins/System.Text.Encoding.CodePages.dll</HintPath>
    </Reference>
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
