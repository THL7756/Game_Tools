<Window x:Class="TableTool.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TableTool.Gui.Rules" Title="UnityTableTool" Height="800" Width="1240" MinHeight="680" MinWidth="980" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,6" /><Setter Property="Margin" Value="4,0" /></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5" /><Setter Property="Margin" Value="6,4" /></Style>
    </Window.Resources>
    <Grid Margin="16"><TabControl>
        <TabItem Header="打表"><Grid Margin="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="导出端" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox x:Name="ClientCheckBox" Content="客户端" IsChecked="True" Margin="0,0,16,0" />
                <CheckBox x:Name="ServerCheckBox" Content="服务器" Margin="0,0,28,0" />
                <TextBlock Text="数据格式" VerticalAlignment="Center" Margin="0,0,10,0" />
                <RadioButton x:Name="JsonRadioButton" Content="JSON" IsChecked="True" GroupName="DataFormat" Margin="0,0,16,0" />
                <RadioButton x:Name="BytesRadioButton" Content="bytes" GroupName="DataFormat" Margin="0,0,16,0" />
                <CheckBox x:Name="CodeCheckBox" Content="C# 代码" IsChecked="True" Margin="0,0,22,0" />
                <Button Content="导出" Click="Export_Click" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="目录和输出选项请在“设置”页调整" VerticalAlignment="Center" Foreground="#777" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="扫描" Click="Scan_Click" /><Button Content="打开设置" Click="OpenSettings_Click" /></StackPanel>
            </Grid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="260" /><ColumnDefinition Width="6" /><ColumnDefinition Width="3*" MinWidth="320" /></Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="表列表" Margin="0,0,12,0"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged" /><ComboBox x:Name="ListFilterComboBox" Grid.Column="1" Width="110" Margin="6,4" SelectionChanged="ListFilterComboBox_SelectionChanged"><ComboBoxItem Content="所有表" Tag="all" /><ComboBoxItem Content="收藏" Tag="favorite" /><ComboBoxItem Content="最近 10 张" Tag="recent" /></ComboBox></Grid>
                    <ListBox x:Name="TableList" Grid.Row="1"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox Grid.Column="0" Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="4" /><Button Grid.Column="1" Content="收藏" Tag="{Binding}" Click="Favorite_Click" Padding="8,3" /><Button Grid.Column="2" Content="打开" Tag="{Binding}" Click="OpenFile_Click" Padding="8,3" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                </Grid></GroupBox>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#D0D0D0" ShowsPreview="True" />
                <TabControl Grid.Column="2"><TabItem Header="检测结果"><ListBox x:Name="LogList" /></TabItem><TabItem Header="字段规则"><ScrollViewer Padding="12"><TextBlock Text="{x:Static local:FieldRulesText.Content}" TextWrapping="Wrap" /></ScrollViewer></TabItem><TabItem Header="字段类型"><ScrollViewer Padding="12"><TextBlock Text="{x:Static local:FieldTypeExamplesText.Content}" TextWrapping="Wrap" /></ScrollViewer></TabItem></TabControl>
            </Grid>
        </Grid></TabItem>
        <TabItem x:Name="SettingsTab" Header="设置"><ScrollViewer><Grid Margin="12" MaxWidth="950" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="表根目录" VerticalAlignment="Center" /><TextBox x:Name="TablePathBox" Grid.Row="0" Grid.Column="1" /><Button Grid.Row="0" Grid.Column="2" Content="浏览" Click="BrowseTablePath_Click" />
            <TextBlock Grid.Row="1" Text="客户端数据目录" VerticalAlignment="Center" /><TextBox x:Name="ClientDataOutputPathBox" Grid.Row="1" Grid.Column="1" /><Button Grid.Row="1" Grid.Column="2" Content="浏览" Tag="client" Click="BrowseDataOutputPath_Click" />
            <TextBlock Grid.Row="2" Text="服务器数据目录" VerticalAlignment="Center" /><TextBox x:Name="ServerDataOutputPathBox" Grid.Row="2" Grid.Column="1" /><Button Grid.Row="2" Grid.Column="2" Content="浏览" Tag="server" Click="BrowseDataOutputPath_Click" />
            <TextBlock Grid.Row="3" Text="代码输出目录" VerticalAlignment="Center" /><TextBox x:Name="CodeOutputPathBox" Grid.Row="3" Grid.Column="1" /><Button Grid.Row="3" Grid.Column="2" Content="浏览" Click="BrowseCodeOutputPath_Click" />
            <TextBlock Grid.Row="4" Text="主题" VerticalAlignment="Center" /><ComboBox x:Name="ThemeComboBox" Grid.Row="4" Grid.Column="1" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged"><ComboBoxItem Content="跟随系统" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" /></ComboBox>
            <TextBlock Grid.Row="5" Text="字体大小" VerticalAlignment="Center" /><Slider x:Name="FontSizeSlider" Grid.Row="5" Grid.Column="1" Minimum="12" Maximum="22" Value="14" Width="220" HorizontalAlignment="Left" ValueChanged="FontSizeSlider_ValueChanged" />
        </Grid></ScrollViewer></TabItem>
    </TabControl></Grid>
</Window>
