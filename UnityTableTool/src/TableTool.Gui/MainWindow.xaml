<!-- 用途：定义应用主窗口、标题栏、菜单、导航和页面宿主。编写日期：2026-10-08；作者：Codex。 -->
<Window x:Class="TableTool.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="游戏开发工具箱"
        Width="1024"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        FontFamily="{DynamicResource Font.Interface}"
        FontSize="{DynamicResource Size.Interface}"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Text.Selectable" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.SelectionCell}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="LogResizeGrip" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Line"
                                    Height="1"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.Border}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<Style x:Key="MenuText" TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Base}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ThemeSegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Chrome}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Image Source="/UnityTableTool;component/Assets/Icons/boxes.png" Width="16" Height="16" />
                <TextBlock Text="游戏开发工具箱" Margin="8,0,0,0" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
<Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click" ToolTip="最小化">
                    <Image Source="/UnityTableTool;component/Assets/Icons/minus.png" Width="12" Height="12" />
                </Button>
<Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click" ToolTip="最大化">
                    <Image Source="/UnityTableTool;component/Assets/Icons/square.png" Width="11" Height="11" />
                </Button>
<Button x:Name="CloseButton" Style="{StaticResource WindowControlButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" ToolTip="关闭">
                    <Image Source="/UnityTableTool;component/Assets/Icons/x.png" Width="13" Height="13" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{DynamicResource Brush.Chrome}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="文件" Style="{StaticResource MenuText}">
                        <MenuItem Header="打开配置表目录" MinWidth="150" Tag="open-tables" Click="MenuAction_Click" />
                        <MenuItem Header="重新扫描" MinWidth="150" Tag="refresh" Click="MenuAction_Click" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="退出" MinWidth="150" Tag="exit" Click="MenuAction_Click" />
                    </MenuItem>
                    
                    <MenuItem Header="编辑" Style="{StaticResource MenuText}">
                        <MenuItem Header="撤销" MinWidth="150" InputGestureText="Ctrl+Z" Tag="undo" Click="MenuAction_Click" />
                        <MenuItem Header="恢复" MinWidth="150" InputGestureText="Ctrl+Y" Tag="redo" Click="MenuAction_Click" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="复制" MinWidth="150" InputGestureText="Ctrl+C" Tag="copy" Click="MenuAction_Click" />
                        <MenuItem Header="剪切" MinWidth="150" InputGestureText="Ctrl+X" Tag="cut" Click="MenuAction_Click" />
                        <MenuItem Header="粘贴" MinWidth="150" InputGestureText="Ctrl+V" Tag="paste" Click="MenuAction_Click" />
                        <Separator Style="{StaticResource MenuSeparatorStyle}" />
                        <MenuItem Header="全选" MinWidth="150" InputGestureText="Ctrl+A" Tag="select-all" Click="MenuAction_Click" />
                        <MenuItem x:Name="SearchMenuItem" Header="搜索" Tag="search" Click="MenuAction_Click" />
                    </MenuItem>
                    <MenuItem Header="查看" Style="{StaticResource MenuText}">
                        <MenuItem Header="白天" MinWidth="150" Tag="light" Click="ThemeMode_Click" />
                        <MenuItem Header="晚上" MinWidth="150" Tag="dark" Click="ThemeMode_Click" />
                        <MenuItem Header="系统" MinWidth="150" Tag="system" Click="ThemeMode_Click" />
                    </MenuItem>
                    <MenuItem Header="使用文档" Style="{StaticResource MenuText}">
                        <MenuItem Header="打开文档目录" MinWidth="150" Tag="docs" Click="MenuAction_Click" />
                    </MenuItem>
                </Menu>
            </StackPanel>

        </Grid>

<Grid Grid.Row="1" HorizontalAlignment="Right" Background="Transparent">
<StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
<TextBlock Text="页面模式" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
<RadioButton x:Name="LightThemeButton" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" Tag="light" Checked="ThemeMode_Checked">
<StackPanel Orientation="Horizontal">
<Image Source="/UnityTableTool;component/Assets/Icons/sun.png" Width="13" Height="13" Margin="0,0,5,0" />
<TextBlock Text="白天" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
</StackPanel>
</RadioButton>
<RadioButton x:Name="DarkThemeButton" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" Tag="dark" Checked="ThemeMode_Checked">
<StackPanel Orientation="Horizontal">
<Image Source="/UnityTableTool;component/Assets/Icons/moon.png" Width="13" Height="13" Margin="0,0,5,0" />
<TextBlock Text="晚上" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
</StackPanel>
</RadioButton>
<RadioButton x:Name="SystemThemeButton" GroupName="ThemeMode" Style="{StaticResource ThemeSegmentButton}" Tag="system" Checked="ThemeMode_Checked">
<StackPanel Orientation="Horizontal">
<Image Source="/UnityTableTool;component/Assets/Icons/monitor.png" Width="13" Height="13" Margin="0,0,5,0" />
<TextBlock Text="系统" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
</StackPanel>
</RadioButton>
<ComboBox x:Name="LanguageCombo" Width="116" Height="32" Margin="12,0,10,0" Style="{StaticResource ComboBox.Field}" DisplayMemberPath="DisplayName" SelectionChanged="LanguageCombo_SelectionChanged">
</ComboBox>
<Button x:Name="SettingsButton" Style="{StaticResource Button.Secondary}" MinWidth="60" Padding="12,6" Click="Settings_Click">
<StackPanel Orientation="Horizontal">
<Image Source="/UnityTableTool;component/Assets/Icons/settings2.png" Width="15" Height="15" Margin="0,0,6,0" />
<TextBlock Text="设置" FontSize="11" />
</StackPanel>
</Button>
</StackPanel>
</Grid>
<Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainSidebarColumn" Width="120" MinWidth="104" MaxWidth="240" />
                <ColumnDefinition x:Name="MainSidebarSplitterColumn" Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Chrome}">
                <DockPanel>
                    <TextBlock Text="工作台" Style="{StaticResource Text.Muted}" Margin="16,14,0,8" DockPanel.Dock="Top" />
                    <StackPanel>
                        <RadioButton x:Name="ConfigNav" GroupName="ModuleNav" Style="{StaticResource SidebarButton}" IsChecked="True" Checked="Module_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/UnityTableTool;component/Assets/Icons/table2.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="配置工具" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ProjectNav" GroupName="ModuleNav" Style="{StaticResource SidebarButton}" Checked="Module_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/UnityTableTool;component/Assets/Icons/folder-kanban.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="项目助手" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AssetsNav" GroupName="ModuleNav" Style="{StaticResource SidebarButton}" Checked="Module_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/UnityTableTool;component/Assets/Icons/images.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="素材工具" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="AudioNav" GroupName="ModuleNav" Style="{StaticResource SidebarButton}" Checked="Module_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/UnityTableTool;component/Assets/Icons/audio-lines.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="音频工具" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PromptNav" GroupName="ModuleNav" Style="{StaticResource SidebarButton}" Checked="Module_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/UnityTableTool;component/Assets/Icons/notebook-text.png" Width="16" Height="16" Margin="0,0,10,0" />
                                <TextBlock Text="提示词" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Style="{StaticResource Splitter.Grip}"
                          Background="{DynamicResource Brush.Chrome}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DragCompleted="LayoutSplitter_DragCompleted" />
            <ContentControl x:Name="MainContent" Grid.Column="2" />
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusPathText" Text="" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button x:Name="LogToggleButton" Grid.Column="1" Style="{StaticResource Button.Icon}" Height="20" MinWidth="52" Padding="8,0" Margin="10,0" Click="LogToggleButton_Click" ToolTip="打开日志">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/notebook-text.png" Width="12" Height="12" Margin="0,0,5,0" />
                        <TextBlock Text="日志" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="UTF-8 · v2.4.0" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="LogOverlayHost" Grid.Row="2" Panel.ZIndex="100" Visibility="Collapsed" Background="#01000000" MouseLeftButtonDown="LogOverlayHost_MouseLeftButtonDown">
            <Border Background="{DynamicResource Brush.Overlay}" Opacity="0.12" IsHitTestVisible="False" />
            <Border x:Name="LogOverlayPanel" Height="320" MaxHeight="560" MinHeight="220" Margin="8,0,8,0" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5,5,0,0" ClipToBounds="True">
                <DockPanel>
                    <Thumb x:Name="LogPanelResizeThumb" DockPanel.Dock="Top" Height="5" Style="{StaticResource LogResizeGrip}" DragDelta="LogPanelResizeThumb_DragDelta" ToolTip="拖动调整日志高度" />
                    <Grid DockPanel.Dock="Top" MinHeight="38" Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="日志" Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <TextBlock x:Name="LogSummaryText" Text="0 条" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Icon}" Width="30" Height="28" Click="CopyLogs_Click" ToolTip="复制日志">
                                <Image Source="/UnityTableTool;component/Assets/Icons/copy.png" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" Width="30" Height="28" Click="ClearLogs_Click" ToolTip="清空日志">
                                <Image Source="/UnityTableTool;component/Assets/Icons/trash2.png" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" Width="30" Height="28" Click="CloseLogs_Click" ToolTip="收起日志">
                                <Image Source="/UnityTableTool;component/Assets/Icons/x.png" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Margin="12,0,12,7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="LogSearchBox" Grid.Row="0" Width="180" MinWidth="140" MaxWidth="220" Height="28" HorizontalAlignment="Left" Style="{StaticResource TextBox.Field}" Padding="9,0" TextChanged="LogSearchBox_TextChanged" ToolTip="搜索分类、来源或消息">
                            <TextBox.Tag>搜索日志</TextBox.Tag>
                        </TextBox>
                        <WrapPanel Grid.Row="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="LogFilterAllButton" Tag="all" Style="{StaticResource Button.Filter}" Content="全部" Click="LogFilter_Click" Margin="0,0,4,0" />
                            <ToggleButton x:Name="LogFilterInfoButton" Tag="INFO" Style="{StaticResource Button.Filter}" Content="信息" Click="LogFilter_Click" Margin="0,0,4,0" />
                            <ToggleButton x:Name="LogFilterSuccessButton" Tag="SUCCESS" Style="{StaticResource Button.Filter}" Content="成功" Click="LogFilter_Click" Margin="0,0,4,0" />
                            <ToggleButton x:Name="LogFilterWarningButton" Tag="WARNING" Style="{StaticResource Button.Filter}" Content="警告" Click="LogFilter_Click" Margin="0,0,4,0" />
                            <ToggleButton x:Name="LogFilterErrorButton" Tag="ERROR" Style="{StaticResource Button.Filter}" Content="错误" Click="LogFilter_Click" Margin="0,0,8,0" />
                            <ToggleButton x:Name="LogCategoryButton" Style="{StaticResource Button.Filter}" Content="分类" Click="LogCategoryButton_Click" Margin="0,0,4,0" />
                            <ToggleButton x:Name="LogCollapseDuplicatesButton" Style="{StaticResource Button.Filter}" Content="重复折叠" Click="LogCollapseDuplicates_Click" Padding="7,4" ToolTip="折叠或展开相同消息" />
                        </WrapPanel>
                        <Popup x:Name="LogCategoryPopup"
                               PlacementTarget="{Binding ElementName=LogCategoryButton}"
                               Placement="Bottom"
                               IsOpen="False"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="8"
                                    Width="210">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                        <Button Style="{StaticResource Button.Icon}" Content="+" Width="28" Height="26" Click="SelectAllLogCategories_Click" ToolTip="全选分类" />
                                        <Button Style="{StaticResource Button.Icon}" Content="−" Width="28" Height="26" Click="ClearAllLogCategories_Click" ToolTip="全不选分类" />
                                    </StackPanel>
                                    <ItemsControl x:Name="LogCategoryFilters">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource CheckBox.Tool}"
                                                          Content="{Binding Label}"
                                                          Tag="{Binding Category}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="LogCategoryFilter_Click"
                                                          Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Height="28" Margin="12,0,12,0" Background="{DynamicResource Brush.SurfaceAlt}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="2" Text="分类" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="3" Text="来源" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="4" Text="消息" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBlock Grid.Column="5" Text="重复" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                    </Grid>
                    <ScrollViewer x:Name="LogsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="LogsScrollViewer_ScrollChanged">
                        <ItemsControl x:Name="LogsList" Margin="12,0,12,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="LogRow"
                                            Height="30"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="105" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="34" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource Text.Selectable}" Text="{Binding TimeText}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="6,0" />
                                            <Border Grid.Column="1" Padding="6,2" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="SUCCESS"><Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="WARNING"><Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="ERROR"><Setter Property="Background" Value="{DynamicResource Brush.ErrorSoft}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DisplayLevel}" FontWeight="SemiBold" FontSize="10" />
                                            </Border>
                                            <TextBox Grid.Column="2" Style="{StaticResource Text.Selectable}" Text="{Binding Category}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBox Grid.Column="3" Style="{StaticResource Text.Selectable}" Text="{Binding Source}" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBox Grid.Column="4" Style="{StaticResource Text.Selectable}" Text="{Binding Message}" Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBlock Grid.Column="5" Text="{Binding DuplicateCountText}" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
