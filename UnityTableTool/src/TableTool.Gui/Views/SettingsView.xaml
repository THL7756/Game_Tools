<!-- 用途：定义外观风格、项目路径、快捷键和关于页设置界面。编写日期：2026-10-06；作者：Codex。 -->
<UserControl x:Class="TableTool.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Window}"
             PreviewMouseWheel="SettingsView_PreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="SettingsNavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="155" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,1">
            <StackPanel>
                <TextBlock Text="设置" FontWeight="SemiBold" FontSize="17" Margin="20,18,0,16" />
                <RadioButton x:Name="AppearanceNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" IsChecked="True" Checked="SettingsNav_Checked" Tag="appearance">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/palette.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="外观风格" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PathsNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="paths">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder1.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="项目路径" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ShortcutsNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/keyboard.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="快捷键" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AboutNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/info.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="关于" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
            <Grid>
                <Grid x:Name="AppearancePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="154" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,12,28,0">
                        <TextBlock Text="设置 / 外观风格" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="视觉风格" Style="{StaticResource Text.Title}" Margin="0,8,0,3" />
                        <TextBlock Text="调整工作台外观，让开发环境更顺手。" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="28,6,28,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="页面模式" Style="{StaticResource Text.SectionDark}" VerticalAlignment="Center" />
                            <TextBlock Text="与顶部模式切换保持同步" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <RadioButton x:Name="LightPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="light" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E7EAF0" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#F8FAFC">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#E7EAF0" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#B5BDC9" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#D5DAE2" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#D5DAE2" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#F8FAFC">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/sun1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="白天" Foreground="#485466" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Stroke="#AEB7C3" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="DarkPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="dark" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#22262D" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#667181" Width="4" Height="4" />
                                            <Ellipse Fill="#667181" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#667181" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#17191D">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#22262D" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#4D8DF7" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#E2E6ED" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#667181" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#17191D">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/moon1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="晚上" Foreground="#E2E6ED" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Fill="#4D8DF7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SystemPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="system" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E7EAF0" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#202329">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#272B32" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#4D8DF7" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#E2E6ED" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#667181" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                        <Border Width="58" Height="44" Background="#F8FAFC" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#202329">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/monitor1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="系统" Foreground="#E2E6ED" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Stroke="#AEB7C3" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>

                    <Border Grid.Row="2" Margin="28,0,28,8" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="主题" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="使用预设主题，或自定义下方颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="32" Margin="0,10,18,0" Style="{StaticResource ComboBox.Field}" SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="炭灰 · 默认深色" />
                                    <ComboBoxItem Content="雾白 · 默认浅色" />
                                    <ComboBoxItem Content="系统" />
                                </ComboBox>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="强调色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="用于选中状态、主要按钮和链接。" Style="{StaticResource Text.Muted}" Margin="0,3 ,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <Border Background="{DynamicResource Brush.Accent}" Width="22" Height="22" Margin="4,0" />
                                    <TextBox x:Name="AccentTextBox" Width="92" Height="32" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="背景色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="工作区的基础背景颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Width="22" Height="22" Margin="4,0" />
                                    <TextBox x:Name="BackgroundTextBox" Width="92" Height="32" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="前景色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="正文、表格数据与主要标签的文字颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <Border Background="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Width="22" Height="22" Margin="4,0" />
                                    <TextBox x:Name="ForegroundTextBox" Width="92" Height="32" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="68">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="310" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="字体设置" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="界面字体、字号、缩放比例" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                    <TextBlock Text="代码与数值使用 JetBrains Mono" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="0,17,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FontCombo" Height="32" Style="{StaticResource ComboBox.Field}" SelectionChanged="FontCombo_SelectionChanged">
                                        <ComboBoxItem Content="Noto Sans SC" />
                                        <ComboBoxItem Content="Microsoft YaHei UI" />
                                        <ComboBoxItem Content="JetBrains Mono" />
                                    </ComboBox>
                                    <ComboBox x:Name="FontSizeCombo" Grid.Column="1" Height="32" Margin="8,0" Style="{StaticResource ComboBox.Field}" SelectionChanged="FontSizeCombo_SelectionChanged">
                                        <ComboBoxItem Content="12 px" />
                                        <ComboBoxItem Content="13 px" />
                                        <ComboBoxItem Content="14 px" />
                                        <ComboBoxItem Content="16 px" />
                                    </ComboBox>
                                    <ComboBox x:Name="ZoomCombo" Grid.Column="2" Height="32" Style="{StaticResource ComboBox.Field}" SelectionChanged="ZoomCombo_SelectionChanged">
                                        <ComboBoxItem Content="90%" />
                                        <ComboBoxItem Content="100%" />
                                        <ComboBoxItem Content="110%" />
                                        <ComboBoxItem Content="125%" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PathsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="28,12,28,0">
                        <TextBlock Text="设置 / 项目路径" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="项目路径" Style="{StaticResource Text.Title}" Margin="0,8,0,3" />
                        <TextBlock Text="管理配置表、输出目录与打表脚本。此处设置仅对当前项目生效。" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="28,0,28,10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="项目根目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="ProjectRootBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="所有相对路径的基准目录" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="root">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/table3.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="配置表目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="TableDirectoryBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="读取 .xlsx、.xls、.csv、.tsv 配置表" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="tables">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/monitor1.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="客户端输出目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="ClientOutputBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="客户端勾选时，将 JSON 文件写入此目录" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="client">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/server.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="服务器输出目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="ServerOutputBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="服务器勾选时，将 JSON 文件写入此目录" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="server">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/file-code2.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="客户端代码目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="ClientCodeOutputBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="客户端代码勾选时，将 C# 文件写入此目录" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="clientCode">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/file-code2.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="服务器代码目录" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="ServerCodeOutputBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="服务器代码勾选时，将 C# 文件写入此目录" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="serverCode">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="80">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/file-code2.png" Width="15" Height="15" Margin="0,0,8,0" />
                                        <TextBlock Text="打表脚本" Style="{StaticResource Text.SectionDark}" />
                                    </StackPanel>
                                    <TextBox x:Name="BuildScriptBox" Height="34" Margin="23,0,10,0" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" />
                                    <TextBlock Text="可选；当前打表由工具内置 JSON 和 C# 导出完成" Style="{StaticResource Text.Muted}" Margin="23,0,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" Margin="0,24,18,0" Style="{StaticResource Button.Secondary}" Click="BrowseFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/package-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="浏览…" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="ShortcutsPanel" Visibility="Collapsed" Margin="28,20">
                    <StackPanel>
                        <TextBlock Text="设置 / 快捷键" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="快捷键" Style="{StaticResource Text.Title}" Margin="0,8,0,18" />
                        <Grid Background="{DynamicResource Brush.Panel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                            </Grid.RowDefinitions>
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="搜索表名" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchShortcutBox" Grid.Column="1" Height="32" Tag="search" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" ToolTip="例如 Ctrl+Shift+K" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" />
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Grid.Row="1" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="打表" VerticalAlignment="Center" />
                                <TextBox x:Name="BuildShortcutBox" Grid.Column="1" Height="32" Tag="build" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" ToolTip="例如 Ctrl+Shift+B" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" />
                            </Grid>
                            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Grid.Row="2" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="刷新表列表" VerticalAlignment="Center" />
                                <TextBox x:Name="RefreshShortcutBox" Grid.Column="1" Height="32" Tag="refresh" Style="{StaticResource TextBox.Field}" FontFamily="{DynamicResource Font.Mono}" ToolTip="例如 Ctrl+Shift+R" IsReadOnly="True" PreviewKeyDown="ShortcutBox_PreviewKeyDown" />
                            </Grid>
                            <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Grid.Row="3" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="上下滚轮步长" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VerticalWheelStepSlider" Minimum="6" Maximum="24" TickFrequency="6" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="WheelStepSlider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="12 px" x:Name="VerticalWheelStepValueText" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Grid.Row="4" Margin="18,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="左右滚轮步长" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="HorizontalWheelStepSlider" Minimum="6" Maximum="24" TickFrequency="6" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="WheelStepSlider_ValueChanged" />
                                    <TextBlock Grid.Column="1" Text="12 px" x:Name="HorizontalWheelStepValueText" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="AboutPanel" Visibility="Collapsed" Margin="28,20">
                    <StackPanel>
                        <TextBlock Text="设置 / 关于" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="游戏开发工具箱" Style="{StaticResource Text.Title}" Margin="0,8,0,4" />
                        <TextBlock Text="版本 2.4.0" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="配置表扫描、校验与 JSON 打表工具。" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,18,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
            </ScrollViewer>

            <Grid Grid.Row="1" Background="{DynamicResource Brush.Panel}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0">
                    <Button Style="{StaticResource Button.Secondary}" Width="96" Height="32" Click="RestoreDefaults_Click" Content="恢复默认" />
                    <Button Style="{StaticResource Button.Primary}" Width="112" Height="32" Margin="10,0,0,0" Click="Save_Click" Content="保存设置" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
