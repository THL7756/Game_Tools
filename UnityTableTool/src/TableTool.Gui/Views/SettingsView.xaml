<TextBlock Text="{Binding Text, ElementName=UnityRuntimePackageBox}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
