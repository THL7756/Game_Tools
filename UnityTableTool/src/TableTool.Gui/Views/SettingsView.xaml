<!-- 用途：定义外观风格、项目路径、快捷键和关于页设置界面。编写日期：2026-10-06；作者：Codex。 -->
<UserControl x:Class="TableTool.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TableTool.Gui.Views"
             Background="{DynamicResource Brush.Window}"
             PreviewMouseWheel="SettingsView_PreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="SettingsNavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="5">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PreviewCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,15,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsNavColumn" Width="155" MinWidth="140" MaxWidth="280" />
            <ColumnDefinition x:Name="SettingsSplitterColumn" Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Chrome}">
            <StackPanel>
                <TextBlock Text="设置" FontWeight="SemiBold" FontSize="17" Margin="20,18,0,16" />
                <RadioButton x:Name="AppearanceNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" IsChecked="True" Checked="SettingsNav_Checked" Tag="appearance">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/palette.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="外观风格" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="外观风格" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="PathsNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="paths">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder1.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="项目路径" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="项目路径" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ShortcutsNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="shortcuts">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/keyboard.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="快捷键" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="快捷键" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="AboutNav" GroupName="SettingsPage" Style="{StaticResource SettingsNavButton}" Checked="SettingsNav_Checked" Tag="about">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/info.png" Width="15" Height="15" Margin="0,0,10,0" />
                        <TextBlock Text="关于" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="关于" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Style="{StaticResource Splitter.Grip}"
                      Background="{DynamicResource Brush.Chrome}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      DragCompleted="LayoutSplitter_DragCompleted" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="52" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid x:Name="AppearancePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90" />
                        <RowDefinition Height="154" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="28,12,28,0">
                        <TextBlock Text="设置 / 外观风格" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="视觉风格" Style="{StaticResource Text.Title}" Margin="0,8,0,3" />
                        <TextBlock Text="调整工作台外观，让开发环境更顺手。" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="28,6,28,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="页面模式" Style="{StaticResource Text.SectionDark}" VerticalAlignment="Center" />
                            <TextBlock Text="与顶部模式切换保持同步" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <UniformGrid Grid.Row="1" Columns="3">
                            <RadioButton x:Name="LightPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="light" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E7EAF0" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#F8FAFC">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#E7EAF0" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#B5BDC9" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#D5DAE2" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#D5DAE2" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#F8FAFC">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/sun1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="白天" Foreground="#485466" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Stroke="#AEB7C3" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="DarkPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="dark" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#22262D" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#667181" Width="4" Height="4" />
                                            <Ellipse Fill="#667181" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#667181" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#17191D">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#22262D" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#4D8DF7" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#E2E6ED" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#667181" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#17191D">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/moon1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="晚上" Foreground="#E2E6ED" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Fill="#4D8DF7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="SystemPreview" GroupName="AppearanceMode" Style="{StaticResource PreviewCard}" Tag="system" Checked="AppearanceMode_Checked">
                                <Grid Height="112">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="24" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#E7EAF0" CornerRadius="3,3,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="5,2">
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" Margin="3,0" />
                                            <Ellipse Fill="#B5BDC9" Width="4" Height="4" />
                                        </StackPanel>
                                    </Border>
                                    <Grid Grid.Row="1" Background="#202329">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#272B32" />
                                        <StackPanel Grid.Column="1" Margin="8,7">
                                            <Rectangle Fill="#4D8DF7" Height="5" Width="70" HorizontalAlignment="Left" />
                                            <Rectangle Fill="#E2E6ED" Height="4" Margin="0,8,0,0" />
                                            <Rectangle Fill="#667181" Height="4" Margin="0,5,28,0" />
                                        </StackPanel>
                                        <Border Width="58" Height="44" Background="#F8FAFC" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#202329">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/monitor1.png" Width="13" Height="13" VerticalAlignment="Center" />
                                        <TextBlock Text="系统" Foreground="#E2E6ED" FontSize="10" Margin="6,0" VerticalAlignment="Center" />
                                        <Ellipse Width="11" Height="11" Stroke="#AEB7C3" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </Grid>

                    <Border Grid.Row="2" Margin="28,0,28,8" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="主题" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="使用预设主题，或自定义下方颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Height="32" Margin="0,10,18,0" Style="{StaticResource ComboBox.Field}" SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="炭灰 · 默认深色" />
                                    <ComboBoxItem Content="雾白 · 默认浅色" />
                                    <ComboBoxItem Content="系统" />
                                </ComboBox>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="强调色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="用于选中状态、主要按钮和链接。" Style="{StaticResource Text.Muted}" Margin="0,3 ,0,0" />
                                </StackPanel>
                                <views:ColorPickerView x:Name="AccentColorPicker"
                                                       Grid.Column="1"
                                                       ColorKey="accent"
                                                       Margin="0,0,18,0"
                                                       PreviewChanged="ColorPicker_PreviewChanged"
                                                       Committed="ColorPicker_Committed"
                                                       Canceled="ColorPicker_Canceled" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="背景色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="工作区的基础背景颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <views:ColorPickerView x:Name="BackgroundColorPicker"
                                                       Grid.Column="1"
                                                       ColorKey="background"
                                                       Margin="0,0,18,0"
                                                       PreviewChanged="ColorPicker_PreviewChanged"
                                                       Committed="ColorPicker_Committed"
                                                       Canceled="ColorPicker_Canceled" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="前景色" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="正文、表格数据与主要标签的文字颜色。" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <views:ColorPickerView x:Name="ForegroundColorPicker"
                                                       Grid.Column="1"
                                                       ColorKey="foreground"
                                                       Margin="0,0,18,0"
                                                       PreviewChanged="ColorPicker_PreviewChanged"
                                                       Committed="ColorPicker_Committed"
                                                       Canceled="ColorPicker_Canceled" />
                            </Grid>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />
                            <Grid Height="68">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="310" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="18,0">
                                    <TextBlock Text="字体设置" Style="{StaticResource Text.SectionDark}" />
                                    <TextBlock Text="界面字体、字号、缩放比例" Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                                    <TextBlock Text="字号可输入 6–72 px" Style="{StaticResource Text.Muted}" />
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="0,17,18,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="76" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FontCombo" Height="32" DisplayMemberPath="Source" Style="{StaticResource ComboBox.Field}" SelectionChanged="FontCombo_SelectionChanged" />
                                    <ComboBox x:Name="FontSizeCombo" Grid.Column="1" Height="32" Margin="8,0" IsEditable="True" IsTextSearchEnabled="False" Style="{StaticResource ComboBox.Field}" ToolTip="输入 6–72，可使用一位小数" SelectionChanged="FontSizeCombo_SelectionChanged" PreviewKeyDown="FontSizeCombo_PreviewKeyDown" LostFocus="FontSizeCombo_LostFocus" />
                                    <ComboBox x:Name="ZoomCombo" Grid.Column="2" Height="32" Style="{StaticResource ComboBox.Field}" SelectionChanged="ZoomCombo_SelectionChanged">
                                        <ComboBoxItem Content="90%" />
                                        <ComboBoxItem Content="100%" />
                                        <ComboBoxItem Content="110%" />
                                        <ComboBoxItem Content="125%" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PathsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="112" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="28,12,28,0">
                        <TextBlock Text="设置 / 项目路径" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="项目路径" Style="{StaticResource Text.Title}" Margin="0,8,0,3" />
                        <TextBlock Text="管理配置表、输出目录与打表脚本。此处设置仅对当前项目生效。" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="28,0,28,10" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6">
    <StackPanel>

        <!-- ===== 项目根目录 ===== -->
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" Margin="12,0,6,0">
                <StackPanel VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock Text="项目根目录" Foreground="{DynamicResource Brush.Text}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="所有相对路径的基准目录" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,12,0">
                <!-- 路径显示：增加 HorizontalAlignment="Right" 实现右对齐 -->
                <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" MinWidth="200" MaxWidth="300" VerticalAlignment="Stretch" Margin="0,0,8,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text, ElementName=ProjectRootBox}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
                <!-- 按钮：MinWidth改为60，文本改为“更改” -->
                <Button MinWidth="60" Height="34" Padding="12,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="root">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="更改" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox x:Name="ProjectRootBox" Visibility="Collapsed"/>
        </Grid>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />

        <!-- ===== 配置表目录 ===== -->
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" Margin="12,0,6,0">
                <StackPanel VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock Text="配置表目录" Foreground="{DynamicResource Brush.Text}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="读取 .xlsx、.xls、.csv、.tsv 配置表" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,12,0">
                <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" MinWidth="200" MaxWidth="300" VerticalAlignment="Stretch" Margin="0,0,8,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text, ElementName=TableDirectoryBox}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button MinWidth="60" Height="34" Padding="12,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="tables">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="更改" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox x:Name="TableDirectoryBox" Visibility="Collapsed"/>
        </Grid>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />

        <!-- ===== 客户端数据目录 ===== -->
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" Margin="12,0,6,0">
                <StackPanel VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock Text="客户端数据目录" Foreground="{DynamicResource Brush.Text}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="客户端勾选时，将 JSON 文件写入此目录" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,12,0">
                <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" MinWidth="200" MaxWidth="300" VerticalAlignment="Stretch" Margin="0,0,8,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Text, ElementName=ClientOutputBox}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Button MinWidth="60" Height="34" Padding="12,0" Style="{StaticResource Button.Secondary}" Click="BrowseFolder_Click" Tag="client">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="更改" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox x:Name="ClientOutputBox" Visibility="Collapsed"/>
        </Grid>

        <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" />

        <!-- ===== 服务器数据目录 ===== -->
        <Grid Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Panel}" CornerRadius="6" Margin="12,0,6,0">
                <StackPanel VerticalAlignment="Center" Margin="16,0,12,0">
                    <TextBlock Text="服务器数据目录" Foreground="{DynamicResource Brush.Text}" FontSize="13" FontWeight="SemiBold"/>
