<UserControl x:Class="TableTool.Gui.Views.WorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Window}">
    <UserControl.Resources>
        <Style x:Key="TableListItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderThickness="2,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="27" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.RowSelected}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Brush.Window}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="配置工具" Style="{StaticResource Text.Title}" FontSize="17" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="里程碑计划" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="SyncText" Text="已同步 14:31" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource Button.Secondary}" Height="30" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/refresh-cw.png" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="刷新表列表" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Secondary}" Height="30" Margin="10,0,0,0" Click="OpenTableDirectory_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/folder-open.png" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="打开配置表目录" FontSize="11" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Height="44" Margin="12,8">
                        <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                            <Grid Margin="9,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="/UnityTableTool;component/Assets/Icons/search.png" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource TextBox.Field}" BorderThickness="0" Background="Transparent" Padding="8,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextChanged="SearchBox_TextChanged" />
                                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="搜索表名或文件名" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="8,0" IsHitTestVisible="False" />
                                <TextBlock Grid.Column="2" Text="⌘ K" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="4,0,2,0" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Height="36" Margin="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="SelectAllCheckBox" Style="{StaticResource CheckBox.Tool}" Content="全选" FontSize="11" Click="SelectAll_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SelectionCountText" Text="已勾选 0 / 0" Foreground="{DynamicResource Brush.Accent}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid DockPanel.Dock="Top" Height="38" Margin="9,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FavoritesFilterButton" Tag="favorites" Style="{StaticResource Button.Icon}" Click="Filter_Click" Margin="3,4">
                            <TextBlock x:Name="FavoritesFilterText" Text="收藏表 0" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="RecentFilterButton" Grid.Column="1" Tag="recent" Style="{StaticResource Button.Icon}" Click="Filter_Click" Margin="3,4">
                            <TextBlock x:Name="RecentFilterText" Text="最近表 0" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="AllFilterButton" Grid.Column="2" Tag="all" Style="{StaticResource Button.Icon}" Click="Filter_Click" Margin="3,4">
                            <TextBlock x:Name="AllFilterText" Text="所有表 0" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Height="26">
                        <TextBlock Text="表名" Style="{StaticResource Text.Muted}" Margin="40,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="打开    收藏" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                    </Grid>

                    <ListBox x:Name="TableList" ItemContainerStyle="{StaticResource TableListItem}" Background="Transparent" BorderThickness="0" SelectionChanged="TableList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="29" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckBox.Tool}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="TableCheck_Click" Tag="{Binding}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="29" Height="26" Click="OpenTable_Click" Tag="{Binding}" ToolTip="打开源文件">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/external-link1.png" Width="14" Height="14" />
                                    </Button>
                                    <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Width="20" Height="26" Click="Favorite_Click" Tag="{Binding}" ToolTip="收藏">
                                        <Image x:Name="FavoriteIcon" Source="/UnityTableTool;component/Assets/Icons/star.png" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="260" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <Image Source="/UnityTableTool;component/Assets/Icons/table3.png" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewTitleText" Text="配置表预览" Style="{StaticResource Text.Section}" Margin="8,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModifiedText" Text="" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SourceText" Text="" Style="{StaticResource Text.Muted}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,190,6" MaxWidth="390" />
                            <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Click="OpenInExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/UnityTableTool;component/Assets/Icons/external-link2.png" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="在 Excel 中打开" FontSize="10" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Background="{DynamicResource Brush.Surface}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <ItemsControl x:Name="SheetTabs">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,6" Background="Transparent">
                                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock x:Name="ReadOnlyText" Text="只读预览 · 0 个字段" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </Grid>

                        <DataGrid x:Name="PreviewGrid" Grid.Row="2" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="38">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="表问题" Style="{StaticResource Text.Section}" />
                                    <TextBlock x:Name="IssueSummaryText" Text="0 错误 / 0 警告" Foreground="{DynamicResource Brush.Warning}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="IssueRangeText" Text="范围：已勾选的配置表" Style="{StaticResource Text.Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="IssuesList" Margin="12,0,12,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Source="/UnityTableTool;component/Assets/Icons/triangle-alert.png" Width="13" Height="13" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Headline}" FontSize="11" Foreground="{DynamicResource Brush.Warning}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" Margin="20,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Height="38">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="打表日志" Style="{StaticResource Text.Section}" />
                                    <TextBlock Text="最近一次" Style="{StaticResource Text.Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="26" Click="CopyLogs_Click" ToolTip="复制日志">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/copy.png" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource Button.Icon}" Width="28" Height="26" Click="ClearLogs_Click" ToolTip="清空日志">
                                        <Image Source="/UnityTableTool;component/Assets/Icons/trash2.png" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LogsList" Margin="12,0,12,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" FontFamily="{DynamicResource Font.Mono}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="{DynamicResource Font.Mono}" FontSize="9" Foreground="{Binding LevelBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{DynamicResource Font.Mono}" FontSize="9" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="输出范围" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox x:Name="ClientCheckBox" Style="{StaticResource CheckBox.Tool}" Content="客户端" IsChecked="True" Checked="OutputTarget_Changed" Unchecked="OutputTarget_Changed" />
                    <CheckBox x:Name="ServerCheckBox" Style="{StaticResource CheckBox.Tool}" Content="服务器" IsChecked="True" Margin="18,0,0,0" Checked="OutputTarget_Changed" Unchecked="OutputTarget_Changed" />
                    <TextBlock x:Name="BuildSelectionText" Text="已勾选 0 张表" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="BuildHintText" Text="0 条警告不阻断输出" Style="{StaticResource Text.Muted}" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="BuildButton" Style="{StaticResource Button.Primary}" Width="140" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Build_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/UnityTableTool;component/Assets/Icons/play.png" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock x:Name="BuildButtonText" Text="打表 (0)" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
