<UserControl x:Class="TableTool.Gui.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.Window}">
    <Grid>
        <Border Margin="36" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Image x:Name="ModuleIcon" Width="36" Height="36" HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" FontSize="20" HorizontalAlignment="Center" Margin="0,16,0,8" />
                <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="4" Padding="10,6" Margin="0,22,0,0">
                    <TextBlock Text="待补充" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
