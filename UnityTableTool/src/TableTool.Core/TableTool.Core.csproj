<!-- 用途：定义工具核心项目，并链接 Runtime Package 的共享类型和值解析源码。编写日期：2026-10-10；作者：Codex。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UnityRuntimePackageDirectory Condition="'$(UnityRuntimePackageDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\UnityRuntimePackage</UnityRuntimePackageDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ExcelDataReader" Version="3.6.0" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
  </ItemGroup>
  <Target Name="ValidateUnityRuntimePackage" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(UnityRuntimePackageDirectory)\com.company.unity-table-runtime\Runtime\Shared')"
           Text="Unity Runtime Package shared code was not found at '$(UnityRuntimePackageDirectory)\com.company.unity-table-runtime\Runtime\Shared'. Set UnityRuntimePackageDirectory to the package root." />
  </Target>
  <ItemGroup>
    <Compile Include="$(UnityRuntimePackageDirectory)\com.company.unity-table-runtime\Runtime\Shared\*.cs"
             Link="RuntimeShared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

