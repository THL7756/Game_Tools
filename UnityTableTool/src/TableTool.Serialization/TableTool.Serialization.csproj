<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityRuntimePackageDirectory Condition="'$(UnityRuntimePackageDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\UnityRuntimePackage</UnityRuntimePackageDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityRuntimePackageDirectory)\com.company.unity-table-runtime\Editor\Shared\Serialization\**\*.cs"
             Link="PackageShared\Serialization\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\TableTool.Core\TableTool.Core.csproj" />
  </ItemGroup>
</Project>

